{
  "name": "@pegasus/domain-reference",
  "version": "0.0.0",
  "private": true,
  "description": "Executable specification of the household-goods moving & storage reference domain model. Not an implementation, and not our system's model.",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src tests tools",
    "typecheck": "tsc --noEmit",
    "alloy": "node alloy/run.mjs",
    "glossary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/generate-glossary.ts",
    "catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/generate-catalog.ts",
    "context-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/generate-context-map.ts",
    "symptom-index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/generate-symptom-index.ts"
  },
  "devDependencies": {
    "prettier": "*",
    "typescript": "*",
    "vitest": "^4.1.12"
  }
}
