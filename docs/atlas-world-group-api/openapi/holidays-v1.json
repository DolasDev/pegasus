  "paths": {
    "/Calendars/Names": {
      "get": {
        "tags": ["Atlas.AzureApi.Holidays"],
        "summary": "Get Calendar Names",
        "description": "Gets the names of all calendars.",
        "operationId": "get-calendars-names",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": ["string"]
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Calendars/{calendarName}/Holidays": {
      "get": {
        "tags": ["Atlas.AzureApi.Holidays"],
        "summary": "Get Holidays",
        "description": "Gets all holidays for the calendar that exist between the startdate and enddate for the given calendar.",
        "operationId": "get-calendar-holidays",
        "parameters": [
          {
            "name": "calendarName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HolidayModel"
                  }
                },
                "example": [
                  {
                    "name": "string",
                    "date": "string"
                  }
                ]
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {
                  "type": "string",
