  "paths": {
    "/RateOrder/{orderNumber}": {
      "get": {
        "tags": ["Rating"],
        "summary": "Rate Order",
        "description": "Rates the Order.",
        "operationId": "rate-order",
        "parameters": [
          {
            "name": "orderNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "On-Behalf-Of",
            "in": "header",
            "description": "Specifies the user on whose behalf the request is made.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Domain.GPInvoiceBuilder.Models.ReturnObjects.GPInvoice.GPRatingResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/IsEligibile/{orderNumber}": {
      "get": {
        "tags": ["Rating"],
        "summary": "Order Eligbility for the new Rating System",
        "description": "Determines if the Order Eligbile for the new Rating System.",
        "operationId": "order-eligibility",
        "parameters": [
          {
            "name": "orderNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "On-Behalf-Of",
            "in": "header",
            "description": "Specifies the user on whose behalf the request is made.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                },
                "example": "True"
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
