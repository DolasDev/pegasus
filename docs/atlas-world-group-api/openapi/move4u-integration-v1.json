            "type": "string"
          },
          "externalKey": {
            "type": "string"
          },
          "itemName": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "lotNumber": {
            "type": "string"
          },
          "itemNumber": {
            "type": "string"
          },
          "colorCode": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "format": "double"
          },
          "defaultWeight": {
            "type": "number",
            "format": "double"
          },
          "volume": {
            "type": "number",
            "format": "double"
          },
          "defaultVolume": {
            "type": "number",
            "format": "double"
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "length": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "isCrate": {
            "type": "boolean"
          },
          "canContainItems": {
            "type": "boolean"
          },
          "isDefaultPackedByOwner": {
            "type": "boolean"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "generalComment": {
            "type": "string"
          },
          "isValuable": {
            "type": "boolean"
          },
          "valuableEstimatedValue": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "isVoid": {
            "type": "boolean"
          },
          "voidReason": {
            "type": "string"
          },
          "isMissing": {
            "type": "boolean"
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetItemsCondition"
            }
          },
          "contents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetItemsContent"
            }
          }
        },
        "additionalProperties": false
      },
      "GetItemsResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "shipmentId": {
            "type": "string"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetItemsRoom"
            }
          }
        },
        "additionalProperties": false
      },
      "GetItemsRoom": {
        "type": "object",
        "properties": {
          "roomCode": {
            "type": "string"
          },
          "externalKey": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetItemsItem"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "subscription-key",
        "in": "query"
      }
    }
  },
  "security": [
    {
      "apiKeyHeader": []
    },
    {
      "apiKeyQuery": []
    }
  ]
}
