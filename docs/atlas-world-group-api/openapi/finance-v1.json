        "description": "Gets a list of MAD email addresses. Pass MIL, NAC, STG or COD for division parameter",
        "operationId": "get-mad-emails",
        "parameters": [
          {
            "name": "agentBranch",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "division",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
