                  "items": {
                    "type": "string"
                  }
                },
                "example": ["string"]
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": ["string"]
              }
            }
          }
        }
      }
    }
