{
  "expo": {
    "name": "Pegasus Move Manager",
    "slug": "moving-storage-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "movingapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.movingstorage.driverapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to scan shipment documents.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to attach shipment documents.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to optimize delivery routes and track order progress."
      }
    },
    "android": {
      "package": "com.movingstorage.driverapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to capture proof of delivery.",
          "cameraPermission": "This app requires camera access to capture proof of delivery photos."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Pegasus to use the camera to scan shipment documents."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2e694fd-15da-47ba-8ef0-8a3e1cd7c4be"
      }
    },
    "owner": "dolas.dev"
  }
}
