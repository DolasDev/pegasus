{
  "expo": {
    "name": "Pegasus Move Manager",
    "slug": "moving-storage-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "movingapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.movingstorage.driverapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Pegasus uses the camera to scan shipment documents.",
        "NSContactsUsageDescription": "Pegasus reads your contacts only when you choose crews to import into your Labor list."
      }
    },
    "android": {
      "package": "com.movingstorage.driverapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.READ_CONTACTS"],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "microphonePermission": false,
          "cameraPermission": "Pegasus uses the camera to scan shipment documents."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Pegasus reads your contacts only when you choose crews to import into your Labor list."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Pegasus uses the camera to scan shipment documents."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2e694fd-15da-47ba-8ef0-8a3e1cd7c4be"
      }
    },
    "owner": "dolas.dev"
  }
}
