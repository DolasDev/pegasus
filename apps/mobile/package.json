{
  "name": "@pegasus/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app",
    "expo:check": "expo install --check",
    "expo:doctor": "npx expo-doctor",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "dev": "REACT_NATIVE_PACKAGER_HOSTNAME=100.69.252.113 npx expo start --clear",
    "store:export": "PEGASUS_STORE_CAPTURE=1 expo export --platform web --output-dir dist-web",
    "store:icons": "node store-assets/scripts/generate-icons.mjs",
    "store:capture": "node store-assets/scripts/capture-screens.mjs",
    "store:compose": "node store-assets/scripts/compose-marketing.mjs"
  },
  "dependencies": {
    "@pegasus/api-http": "*",
    "@pegasus/auth": "*",
    "@pegasus/domain": "*",
    "@pegasus/theme": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.9.4",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-default-from": "^7.27.1",
    "@babel/plugin-transform-react-display-name": "^7.28.0",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "babel-jest": "^30.5.0",
    "babel-preset-expo": "55.0.25",
    "detect-newline": "^3.1.0",
    "jest": "^30.5.0",
    "jest-environment-node": "^30.4.1",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-get-random-values",
        "@types/jest",
        "jest",
        "typescript"
