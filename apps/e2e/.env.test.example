# apps/e2e env reference — copy what you need into:
#   .env.test        (TRACKED — committed defaults for the `local` target only)
#   .env.test.local  (GITIGNORED — your machine's overrides + all secrets)
#
# Loaded by playwright.config.ts: .env.test.local first (wins), then .env.test.
# Anything already exported / passed on the CLI wins over both. See REMOTE.md and QA.md.
# ---------------------------------------------------------------------------------------


# === local target (E2E_TARGET unset) — already the committed contents of .env.test ===
DATABASE_URL="postgresql://pegasus:pegasus@localhost:5432/pegasus"
DIRECT_URL="postgresql://pegasus:pegasus@localhost:5432/pegasus"
TEST_TENANT_ID="e2e00000-0000-0000-0000-000000000001"
DEFAULT_TENANT_ID="e2e00000-0000-0000-0000-000000000001"
SKIP_AUTH=true
PORT=3001
HOST=0.0.0.0
NODE_ENV=test


# === remote target (E2E_TARGET=remote) — staging gate; see REMOTE.md ===
# E2E_API_BASE_URL=https://api-staging.dolas.dev
# WEB_URL=https://pegasus-staging.dolas.dev
# E2E_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# E2E_COGNITO_TENANT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# E2E_STAGING_TENANT_ID=00000000-0000-0000-0000-000000000000
# E2E_STAGING_ADMIN_USERNAME=e2e-admin@pegasus-test.invalid
# E2E_STAGING_ADMIN_PASSWORD=                       # SECRET → .env.test.local only


# === qa target (E2E_TARGET=qa) — the /driver-planning longhaul suite; see QA.md ===
# QA_WEB_URL=https://pegasus-qa.dolas.dev
# QA_API_BASE_URL=https://api-qa.dolas.dev
# QA_TENANT_ID=00000000-0000-0000-0000-000000000000
# QA_TENANT_NAME=Acme Movers                        # only needed if the email maps to >1 tenant
# QA_USER_USERNAME=e2e-qa@pegasus-test.invalid
# QA_USER_PASSWORD=                                 # SECRET → .env.test.local only


# === optional knobs ===
# MSSQL_HOST=localhost                              # enables tests/api/longhaul.spec.ts (local)
# TEST_WINDOWS_USER=testuser                        # X-Windows-User for local longhaul specs
