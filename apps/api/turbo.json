{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "prisma/schema.prisma",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ]
    },
    "typecheck": { "inputs": ["$TURBO_DEFAULT$", "prisma/**"] }
  }
}
