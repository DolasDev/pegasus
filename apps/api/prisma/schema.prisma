  OUTBOUND

  @@schema("public")
}

enum MessageSource {
  THREAD_STORE
  V1_STORE

  @@schema("public")
}

enum MessageStatus {
  CAPTURED
  FORWARDED
  FAILED

  @@schema("public")
}

enum ForwardStatus {
  PENDING
  SENT
  FAILED
  DEAD

