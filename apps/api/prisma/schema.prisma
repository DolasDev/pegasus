enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("public")
}

/// One connected RingCentral account per tenant (covering one or more
/// SMS-enabled numbers). The rotating OAuth refresh token lives in Secrets
/// Manager; only its ARN is persisted here and is NEVER returned by any API.
model RingCentralConnection {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// RingCentral account id (the `~` account this connection authorises).
  rcAccountId String @map("rc_account_id")

  /// RingCentral extension id whose token/number this connection owns.
  rcExtensionId String @map("rc_extension_id")

  /// The primary SMS-enabled number for this connection, E.164.
  ownerNumber String @map("owner_number")

  /// Secrets Manager ARN holding the rotating OAuth refresh token.
  /// Null until the OAuth connect flow completes. NEVER returned from the API.
  tokenSecretArn String? @map("token_secret_arn")

  tokenStatus     RcTokenStatus      @default(ACTIVE) @map("token_status")
  scopes          String[]
  lastRefreshedAt DateTime?          @map("last_refreshed_at") @db.Timestamptz(6)
  health          RcConnectionHealth @default(HEALTHY)

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subscriptions RingCentralSubscription[]
  syncCursors   RingCentralSyncCursor[]
  messages      Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, rcAccountId, rcExtensionId])
  @@index([tenantId])
  @@map("ringcentral_connections")
  @@schema("public")
}

/// A managed RingCentral webhook subscription. One shared webhook URL serves
/// all tenants; each subscription carries its own verificationToken and the
/// event payload's subscriptionId maps back to this row → connection → tenant.
model RingCentralSubscription {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  /// RingCentral's subscription id — the key the webhook payload resolves on.
  subscriptionId String @map("subscription_id")

  eventFilters      String[] @map("event_filters")
  transport         String   @default("WebHook")
  deliveryAddress   String   @map("delivery_address")
  /// Shared secret echoed by RC on each delivery; compared on the webhook leg.
  verificationToken String   @map("verification_token")

  expiresAt     DateTime             @map("expires_at")
  status        RcSubscriptionStatus @default(ACTIVE)
  lastRenewedAt DateTime?            @map("last_renewed_at")
  failureCount  Int                  @default(0) @map("failure_count")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([subscriptionId])
  @@index([tenantId])
  @@index([connectionId])
  @@index([status, expiresAt])
  @@map("ringcentral_subscriptions")
  @@schema("public")
}

/// Per-store sync token — the reconciliation-sync safety net's memory.
model RingCentralSyncCursor {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  store      RcSyncStore
  syncToken  String?     @map("sync_token")
  lastSyncAt DateTime?   @map("last_sync_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, connectionId, store])
  @@index([tenantId])
  @@map("ringcentral_sync_cursors")
  @@schema("public")
}

/// Raw webhook event inbox — fast-ack landing zone for replay/audit. Persisted
/// only after the subscriptionId resolves to a tenant (the handshake returns
/// before any row is written).
model InboundWebhookEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  subscriptionId String? @map("subscription_id")
  connectionId   String? @map("connection_id")

  rawPayload Json @map("raw_payload")
  headers    Json

  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  status      WebhookEventStatus @default(PENDING)
  error       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([receivedAt])
  @@map("inbound_webhook_events")
  @@schema("public")
}

/// A normalised captured SMS — transient cloud buffer. The `@@unique([tenantId,
/// source, externalId])` is the idempotency linchpin: webhook-path and
/// sync-path upserts converge on it, giving exactly one row per message.
model Message {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  connectionId String? @map("connection_id")

  source     MessageSource
  externalId String           @map("external_id")
  threadId   String?          @map("thread_id")
  direction  MessageDirection
  fromNumber String           @map("from_number")
  toNumber   String           @map("to_number")
  body       String?

  rcCreationTime     DateTime  @map("rc_creation_time") @db.Timestamptz(6)
  rcLastModifiedTime DateTime? @map("rc_last_modified_time") @db.Timestamptz(6)

  status        MessageStatus @default(CAPTURED)
  forwardStatus ForwardStatus @default(PENDING) @map("forward_status")

  /// Set when the PII body is nulled (72h after the forward succeeds).
  bodyPurgedAt DateTime? @map("body_purged_at") @db.Timestamptz(6)
  /// When the body becomes eligible for purge (forward time + 72h).
  purgeAfter   DateTime? @map("purge_after") @db.Timestamptz(6)

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outbox     MessageForwardOutbox?

  @@unique([tenantId, source, externalId])
  @@index([tenantId, forwardStatus])
  @@index([tenantId, rcCreationTime])
  @@map("messages")
  @@schema("public")
}

/// Transactional outbox driving reliable on-prem delivery. One row per Message;
/// the forwarder drains PENDING rows (nextAttemptAt <= now) into the on-prem
/// SQL Server, backing off on failure and dead-lettering after N attempts.
model MessageForwardOutbox {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  messageId String @map("message_id")

  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  status        ForwardStatus @default(PENDING)
  lastError     String?       @map("last_error")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([messageId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("message_forward_outbox")
  @@schema("public")
}

/// A push-notification device registration. One row per (tenant, Expo push
/// token), written by the mobile app via POST /api/v1/device-tokens once the
/// driver grants notification permission. The push forwarder resolves a target
/// user/crew member into the active tokens here. Tokens that Expo reports as
/// DeviceNotRegistered are deactivated (isActive=false) rather than deleted,
/// preserving history. Tenant-scoped via lib/prisma.ts.
model DeviceToken {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The tenant login this device belongs to. A driver's CrewMember row links
  /// to this user via CrewMember.tenantUserId, so crew targeting resolves
  /// through here.
  userId String @map("user_id")

  platform      DevicePlatform
  expoPushToken String         @map("expo_push_token")
  isActive      Boolean        @default(true) @map("is_active")

  /// Refreshed each time the app re-registers (login / foreground resume), so
  /// stale devices can be aged out.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, expoPushToken])
  @@index([tenantId, userId, isActive])
  @@map("device_tokens")
  @@schema("public")
}

/// Transactional outbox driving reliable push delivery. One row per logical
/// notification; the push forwarder drains PENDING rows (nextAttemptAt <= now),
/// resolves the target into active DeviceToken rows, sends via Expo, records the
/// ticket, backs off on failure and dead-letters after N attempts — the same
/// shape as MessageForwardOutbox. `payload` carries a generic { title, body,
/// data } envelope so notification copy/actions live outside the schema.
model PushNotificationOutbox {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Target. Exactly one of userId / crewMemberId is set; the forwarder
  /// resolves either into that principal's active DeviceToken rows.
  userId       String? @map("user_id")
  crewMemberId String? @map("crew_member_id")

  /// Generic notification envelope: { title, body, data: { ...deep link } }.
  payload Json

  /// Optional idempotency key. A non-null value is unique per tenant, so a
  /// retried enqueue for the same logical event (e.g.
  /// "move.assigned:<moveId>:<crewMemberId>") collapses to one row. NULLs are
  /// distinct in Postgres, so ad-hoc sends omit it.
  dedupeKey String? @map("dedupe_key")

  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  status        ForwardStatus @default(PENDING)
  lastError     String?       @map("last_error")

  /// Expo push ticket id from send; used to poll the delivery receipt later.
  expoTicketId  String? @map("expo_ticket_id")
  expoReceiptId String? @map("expo_receipt_id")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user       TenantUser? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, nextAttemptAt])
  @@map("push_notification_outbox")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Shipment-event inbox — idempotent landing for legacy MoveManager events.
//
// The on-prem Pegasus.Outbox.Relay (a separate .NET service) drains the legacy
// `dbo.Outbox` table and publishes Shipment.Opened / Shipment.Closed to an SNS
// FIFO topic, which fans out to an SQS FIFO queue. lambda-shipment-event-consume
// drains that queue. Delivery is at-least-once, so the consumer dedupes on the
// relay's `messageId` (the Outbox row's MessageId GUID) — this table IS the
// dedupe gate: a row's presence means the message was already accepted.
//
// Not tenant-facing (legacy events carry no Pegasus tenant id — MoveManager is
// per-site), so it lives in the `platform` schema with no tenant relation.
// `dispatchedAt` is the onward-dispatch hook for a later slice (e.g. fan-out to
// a partner consumer); null = ingested-but-not-forwarded.
// ---------------------------------------------------------------------------
model ShipmentEventInbox {
  /// Relay-supplied MessageId (the legacy Outbox row's GUID). The idempotency key.
  messageId String @id @map("message_id")

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventType     String @map("event_type")
  schemaVersion Int    @map("schema_version")

  /// SNS `source` message attribute (Relay `Source` config, e.g. "MoveManager").
  source String

  /// The event body as published by the relay (pointer, not authoritative state).
  payload Json

  /// When the domain change happened on-prem (the Outbox row's OccurredAtUtc).
  occurredAtUtc DateTime @map("occurred_at_utc") @db.Timestamptz(6)

  /// When this cloud consumer first accepted the message.
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  /// Onward-dispatch hook (later slice). Null = ingested, not yet forwarded.
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)

  @@index([dispatchedAt, occurredAtUtc])
  @@map("shipment_event_inbox")
  @@schema("platform")
}
