  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([moveId])
  @@index([status])
  @@map("invoices")
  @@schema("public")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String        @map("invoice_id")
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD")
  method    PaymentMethod
  paidAt    DateTime      @map("paid_at")
  reference String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@map("payments")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Platform schema — admin-only tables
//
// These models live in the `platform` PostgreSQL schema. They are never
// queried by tenant-facing API routes or the tenant-scoped Prisma extension.
// The platform schema is not accessible to TENANT_USER-scoped requests.
// ---------------------------------------------------------------------------

/// Tracks Cognito users who have been granted platform administrator access.
/// A record is upserted on first successful admin portal sign-in using the
/// Cognito sub claim as the stable identifier.
model AdminUser {
  id          String  @id @default(uuid())
  /// Stable Cognito user identifier (JWT `sub` claim). Never changes even if
  /// the user updates their email address.
  cognitoSub  String  @unique @map("cognito_sub")
  email       String  @unique
  displayName String? @map("display_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
  @@schema("platform")
}

/// Append-only audit trail for every action taken by a platform administrator.
///
/// `before` and `after` capture JSON snapshots of the affected resource so the
/// full change history can be reconstructed. Neither field is set for the
/// irrelevant side (before=null on create, after=null on hard delete).
model AuditLog {
  id           String   @id @default(uuid())
  /// Cognito sub of the administrator who performed the action.
  adminSub     String   @map("admin_sub")
  /// Denormalised email for display — avoids joins when rendering the log.
  adminEmail   String   @map("admin_email")
  /// Action identifier. Values: CREATE_TENANT | UPDATE_TENANT |
  /// SUSPEND_TENANT | REACTIVATE_TENANT | OFFBOARD_TENANT
  action       String
  /// Type of the affected resource. Currently always "TENANT".
  resourceType String   @map("resource_type")
  /// ID of the affected resource.
  resourceId   String   @map("resource_id")
  /// Snapshot of the resource before the mutation (null for creates).
  before       Json?
  /// Snapshot of the resource after the mutation (null for hard deletes).
  after        Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  /// No updatedAt — audit logs are immutable once written.
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceId])
  @@index([adminSub])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Integration events — inbound events published to the Pegasus event queue
// by external vendors and services. The Python-based service processes these
// and writes them to the legacy SQL Server. Events are tenant-scoped and
// deleted from the queue once processed.
// ---------------------------------------------------------------------------

/// An inbound integration event received from an external system or vendor.
/// After the consumer reads and processes the event it is deleted (DELETE /events/:id).
model PegasusEvent {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// External event identifier assigned by the publisher. Unique globally.
  eventApiId String @unique @map("event_api_id")

  /// Logical event type used for routing (e.g. "LEAD_CREATED", "MOVE_UPDATED").
  eventType String @map("event_type")

  /// Original timestamp from the publisher.
  eventDatetime DateTime? @map("event_datetime")

  /// Processing state: NEW → IN_PROGRESS → PROCESSED | ERROR.
  eventStatus String @default("NEW") @map("event_status")

  /// Name or identifier of the system that published this event.
  eventPublisher String? @map("event_publisher")

  /// Arbitrary JSON payload from the publisher — schema varies by event type.
  eventData Json? @map("event_data")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([tenantId, eventStatus])
  @@map("pegasus_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Document storage — polymorphic attachments for any tenant entity.
//
// The row is created with status PENDING_UPLOAD when a presigned PUT URL is
// issued. After the client confirms the upload, a finalize call promotes it
// to ACTIVE. S3 coordinates (bucket/key) are infrastructure and never leak
// past the repository layer.
// ---------------------------------------------------------------------------

model Document {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Polymorphic back-reference. Not a FK — entity tables live in many
  /// bounded contexts. Tenant scoping plus the composite index keeps lookups
  /// cheap.
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Free-form classification (e.g. "contract", "photo", "bol", "receipt").
  documentType String  @map("document_type")
  category     String?

  s3Bucket  String @map("s3_bucket")
  s3Key     String @map("s3_key")
  filename  String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  status     DocumentStatus @default(PENDING_UPLOAD)
  /// TenantUser.id of the uploader.
  uploadedBy String         @map("uploaded_by")
  expiresAt  DateTime?      @map("expires_at")
  deletedAt  DateTime?      @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  variants DocumentVariant[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, documentType])
  @@index([tenantId, status])
  @@map("documents")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Document variants — eager derived assets (thumb + web) generated out-of-band
// by the converter Lambda. One row per (document, variant). The unique
// constraint + upsert is the entire concurrency story: re-delivery of the
// S3 ObjectCreated event is a no-op.
// ---------------------------------------------------------------------------

model DocumentVariant {
  id            String                @id @default(uuid())
  documentId    String                @map("document_id")
  variant       DocumentVariantKind
  status        DocumentVariantStatus @default(PENDING)
  s3Key         String?               @map("s3_key")
  sizeBytes     Int?                  @map("size_bytes")
  width         Int?
  height        Int?
  failureReason String?               @map("failure_reason")
  generatedAt   DateTime?             @map("generated_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, variant])
  @@index([status])
  @@map("document_variants")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflows — uploaded Python workflow artifacts.
//
// Each row represents one immutable (name, version) tuple owned by a tenant.
// Visibility=GLOBAL workflows belong to the platform tenant and are readable
// by every tenant; visibility=TENANT workflows are readable only by the
// owning tenant. The artifact itself is a zip stored in the documents bucket
// at `workflows/{tenantId}/{workflowId}/{version}.zip`.
//
// Not included in TENANT_SCOPED_MODELS (see lib/prisma.ts) because the GLOBAL
// case requires reading rows owned by a different tenant. The repository
// scopes manually.
// ---------------------------------------------------------------------------

enum WorkflowVisibility {
  /// Owned by the platform tenant; readable by every tenant.
  GLOBAL
  /// Owned by a single tenant; readable only by that tenant.
  TENANT

  @@schema("public")
}

/// A published, versioned integration-validator config: the output-shaped
/// mapping template, the decision-table rule set, and the golden corpus bundled
/// with it. Append-only — each publish inserts a new immutable
/// (integrationId, tenantId, version) row; a publish marks prior PUBLISHED rows
/// SUPERSEDED. Visibility is derived server-side from the publishing tenant's
/// isPlatformTenant flag (GLOBAL ⇒ platform tenant, readable by all), exactly
/// like Workflow. NOT in TENANT_SCOPED_MODELS — the repository hand-scopes reads
/// to (owner ∪ GLOBAL).
model IntegrationConfig {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Target integration id (e.g. "demo_partner"). Matches a built-in
  /// IntegrationDefinition id; not an FK — integration ids are code-defined.
  integrationId String @map("integration_id")

  /// Monotonic version per (integrationId, tenantId). Uploads are immutable.
  version Int

  /// Derived server-side from the publishing tenant's isPlatformTenant flag.
  visibility IntegrationConfigVisibility @default(TENANT)

  /// Lifecycle status; a publish supersedes prior PUBLISHED rows for the scope.
  status IntegrationConfigStatus @default(PUBLISHED)

  /// Output-shaped mapping template (validated against the published schema).
  mapping Json

  /// Decision-table rule set.
  rules Json

  /// Golden-corpus fixtures bundled with this config and run by the gate.
  corpus Json

  /// Full gate-pipeline report captured at publish (static checks + corpus run).
  gateReport Json @map("gate_report")

  /// TenantUser.id (or service-account id) of the publisher. Denormalised; not an FK.
  publishedBy String @map("published_by")

  /// Set when this config was created by forking a GLOBAL platform config
  /// ("fork to my tenant"). Holds the source IntegrationConfig.id. Null for
  /// directly-published configs. Not an FK so the row survives source deletion.
  forkedFromConfigId String? @map("forked_from_config_id")

  /// The source config's version at fork time. Null for direct publishes.
  forkedFromVersion Int? @map("forked_from_version")

  /// Type floor this overlay is built on (sdk-feedback 0020), e.g.
  /// "shipment_status_update". Null ⇒ resolve via the built-in overlay's floor
  /// for this integrationId. Lets a NEW partner target an existing floor from a
  /// published config alone — no new code floor.
  floor String?

  /// Human-facing label decoupled from integrationId (sdk-feedback 0019). Null ⇒
  /// fall back to the built-in overlay's displayName, else the id.
  displayName String? @map("display_name")

  /// Partner external output shape as a JSON Schema (sdk-feedback 0020). Null ⇒
  /// the external body IS the canonical (identity). Gate-checked at publish.
  externalShape Json? @map("external_shape")

  /// Canonical → partner-external projection, output-shaped like `mapping`
  /// (0020). Null ⇒ identity (external == canonical).
  externalMapping Json? @map("external_mapping")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([integrationId, tenantId, version])
  @@index([integrationId, visibility])
  @@index([tenantId])
  @@map("integration_configs")
  @@schema("public")
}

enum IntegrationConfigVisibility {
  /// Owned by the platform tenant; readable by every tenant.
  GLOBAL
  /// Owned by a single tenant; readable only by that tenant.
  TENANT

  @@schema("public")
}

enum IntegrationConfigStatus {
  /// The current live config for its (integrationId, scope).
  PUBLISHED
  /// Replaced by a newer published version.
  SUPERSEDED

  @@schema("public")
}

/// Lifecycle status of a single server-side workflow execution. The runtime
/// state machine is: QUEUED → RUNNING → COMPLETED | FAILED | TIMED_OUT |
/// CANCELLED.
enum WorkflowExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED

  @@schema("public")
}

/// What kind of trigger a WorkflowTrigger row describes. EVENT rows match
/// domain-event outbox rows; SCHEDULE rows are realized as Temporal Schedules
/// (Phase 3 Unit 4 — inert until then).
enum WorkflowTriggerKind {
  EVENT
  SCHEDULE

  @@schema("public")
}

/// Provenance of a WorkflowExecution: started manually by a user (USER) or
/// fired by a trigger (EVENT / SCHEDULE). Trigger-fired executions have no
/// triggeredByUserId.
enum WorkflowExecutionTriggerSource {
  USER
  EVENT
  SCHEDULE

  @@schema("public")
}

model Workflow {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Workflow name (matches the SDK manifest `name` field).
  name String

  /// Workflow version (matches the SDK manifest `version` field). Together
  /// with (tenantId, name) this forms a unique tuple — uploads are immutable.
  version String

  /// Derived server-side from the uploading principal's tenant — GLOBAL if
  /// the tenant has isPlatformTenant=true, TENANT otherwise.
  visibility WorkflowVisibility @default(TENANT)

  /// S3 key inside the documents bucket. Never returned in API responses.
  artifactKey String @map("artifact_key")

  /// Validated manifest payload from the upload, kept for display
  /// (entry-point listing, activity declarations) without re-reading S3.
  manifest Json

  /// TenantUser.id of the uploader (the principal that called finalize).
  /// Denormalised; not an FK so the row survives user deletion.
  createdByUserId String @map("created_by_user_id")

  /// Set when this workflow was created by forking another workflow (the
  /// "fork to my store" flow). Holds the source Workflow.id. Null for
  /// directly-uploaded workflows. Not an FK so the row survives source
  /// deletion.
  forkedFromWorkflowId String? @map("forked_from_workflow_id")

  /// The source workflow's version at the time of the fork. Null for
  /// directly-uploaded workflows.
  forkedFromVersion String? @map("forked_from_version")

  /// Encrypted runtime credential (ciphertext) for the per-workflow runtime
  /// service account. Null until a runtime account is provisioned. Never
  /// returned in API responses.
  runtimeTokenCiphertext String? @map("runtime_token_ciphertext")

  /// ApiClient.id of the per-workflow runtime service account. Null until a
  /// runtime account is provisioned.
  runtimeApiClientId String? @map("runtime_api_client_id")

  /// SHA-256 (hex) of the artifact zip, computed server-side at finalize
  /// (Phase 3 Unit 6). Null for rows finalized before integrity validation
  /// existed — they become executable on re-upload.
  artifactSha256 String? @map("artifact_sha256")

  /// Artifact zip size in bytes, recorded at finalize alongside the digest.
  /// Null for pre-Unit-6 rows.
  artifactSizeBytes Int? @map("artifact_size_bytes")

  /// True when the artifact passed integrity validation at finalize (zip
  /// structure sound, every manifest entry point resolves to a file in the
  /// zip, no pip dependencies, within the 10 MB cap). Derived server-side
  /// only — never client-settable. NOTE: the run path still enforces the
  /// curated-names gate (lib/curated-workflows.ts) until Phase 3 Unit 10;
  /// this flag records *eligibility*, it does not open execution yet.
  executable Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  executions WorkflowExecution[]
  triggers   WorkflowTrigger[]

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@index([visibility])
  @@map("workflows")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflow executions — server-side runtime invocations of a workflow.
//
// Each row records one execution of a Workflow: the input it was given, its
// lifecycle status, the eventual result or error, and the Temporal workflow
// /run identifiers that back the runtime. Always owned by a single tenant —
// included in TENANT_SCOPED_MODELS (see lib/prisma.ts) so reads/writes are
// auto-scoped.
// ---------------------------------------------------------------------------

model WorkflowExecution {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The workflow this execution runs.
  workflowId String @map("workflow_id")

  /// Lifecycle status of this execution.
  status WorkflowExecutionStatus @default(QUEUED)

  /// The input payload the execution was started with.
  input Json

  /// The result payload on successful completion. Null until COMPLETED. For a
  /// dry run this holds the trace envelope { dryRun, return, trace, captured }.
  result Json?

  /// True when this execution was started in DRY-RUN mode (reads live,
  /// mutations captured not performed). Dry-runs are excluded from the
  /// TENANT_RUNNER concurrency cap and daily quota, and are tagged in Temporal
  /// with a matching memo. Only tenant-runner workflows can be dry-run.
  dryRun Boolean @default(false) @map("dry_run")

  /// Human-readable failure reason. Set for FAILED / TIMED_OUT / CANCELLED.
  errorMessage String? @map("error_message")

  /// Temporal workflow identifier backing this execution. Null until queued
  /// onto the runtime.
  temporalWorkflowId String? @map("temporal_workflow_id")

  /// Temporal run identifier backing this execution. Null until queued.
  temporalRunId String? @map("temporal_run_id")

  /// TenantUser.id of the principal that triggered this execution. Null for
  /// trigger-fired executions (triggerSource EVENT / SCHEDULE) — those carry
  /// triggeredByTriggerId instead. Denormalised; not an FK so the row
  /// survives user deletion.
  triggeredByUserId String? @map("triggered_by_user_id")

  /// Provenance of this execution. USER = manual POST /:id/run; EVENT /
  /// SCHEDULE = fired by a WorkflowTrigger (Phase 3 Units 3/4).
  triggerSource WorkflowExecutionTriggerSource @default(USER) @map("trigger_source")

  /// WorkflowTrigger.id that fired this execution. Null for USER-source
  /// executions. Denormalised; not an FK so the row survives trigger deletion.
  triggeredByTriggerId String? @map("triggered_by_trigger_id")

  queuedAt   DateTime  @map("queued_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([tenantId, workflowId])
  @@index([status])
  /// Composite index for the TENANT_RUNNER daily-quota count (Phase 3 Unit 10):
  /// `WHERE tenantId = $1 AND createdAt >= $utcDayStart`. The tenantId-first
  /// ordering means the query touches only one tenant's rows.
  @@index([tenantId, createdAt])
  @@map("workflow_executions")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflow triggers — event / schedule subscriptions that fire a workflow.
//
// Each row attaches one trigger to one workflow. EVENT rows subscribe to a
// domain-event type (canonical taxonomy in apps/api/src/lib/domain-events.ts)
// with an optional payload-match filter; SCHEDULE rows carry a cron
// expression realized as a Temporal Schedule in Phase 3 Unit 4 — until then
// SCHEDULE rows are stored but inert. Nothing fires triggers yet: the Unit 3
// dispatcher will match enabled EVENT rows against undispatched DomainEvent
// rows via the (kind, enabled, eventType) index below.
//
// Always owned by a single tenant (a tenant's trigger on a GLOBAL workflow is
// still the tenant's own row) — included in TENANT_SCOPED_MODELS (see
// lib/prisma.ts) so reads/writes are auto-scoped.
// ---------------------------------------------------------------------------

model WorkflowTrigger {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The workflow this trigger fires. Cascade so a deleted workflow's
  /// triggers do not linger.
  workflowId String @map("workflow_id")

  /// EVENT (domain-event subscription) or SCHEDULE (cron).
  kind WorkflowTriggerKind

  /// EVENT kind: one of the five domain-event types (lib/domain-events.ts).
  /// Null for SCHEDULE rows.
  eventType String? @map("event_type")

  /// EVENT kind: optional payload-match object. Opaque in this unit — the
  /// Unit 3 dispatcher defines match semantics. Null for SCHEDULE rows.
  filter Json?

  /// SCHEDULE kind: 5-field cron expression. Shape-validated at the API;
  /// full semantic validation happens when Unit 4 realizes it as a Temporal
  /// Schedule. Null for EVENT rows.
  cronExpression String? @map("cron_expression")

  /// Disabled triggers are kept but never fired.
  enabled Boolean @default(true)

  /// TenantUser.id of the creator. Denormalised; not an FK so the row
  /// survives user deletion (matches Workflow.createdByUserId).
  createdByUserId String @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId])
  @@index([kind, enabled, eventType])
  @@map("workflow_triggers")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Domain-event outbox — transactional outbox for platform domain events.
//
// Rows are written by emitDomainEvent() (lib/domain-events.ts) inside the SAME
// Prisma transaction as the domain state change they describe, which keeps
// emission atomic with the write. Nothing consumes the table yet — the Phase 3
// trigger dispatcher (a poller Lambda mirroring the reconcile-poller pattern)
// will drain undispatched rows in (dispatchedAt, occurredAt) order and stamp
// dispatchedAt. The five launch event types are a public contract; see
// lib/domain-events.ts for the canonical taxonomy.
// ---------------------------------------------------------------------------

model DomainEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Event taxonomy name (e.g. "quote.accepted"). Canonical list lives in
  /// apps/api/src/lib/domain-events.ts — renames are breaking.
  eventType String @map("event_type")

  /// Event-specific payload (entity ids + minimal context). Consumers must
  /// refetch authoritative state; the payload is a pointer, not a snapshot.
  payload Json

  /// When the domain state change happened (transaction time).
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Stamped by the trigger dispatcher once the event has been processed.
  /// Null = pending. Drain order is (dispatchedAt, occurredAt).
  dispatchedAt DateTime? @map("dispatched_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([dispatchedAt, occurredAt])
  @@index([tenantId])
  @@map("domain_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Tenant event-type registry — tenant-defined custom event names that custom
// workflows can trigger on.
//
// The built-in event taxonomy (DOMAIN_EVENT_TYPES in lib/domain-events.ts) is a
// fixed 5-name platform contract. This table lets a tenant register ADDITIONAL
// event names (e.g. "lead.qualified") that flow through the very same
// DomainEvent outbox + dispatcher — the dispatcher already matches eventType by
// raw string equality, so a custom name routes with no dispatcher change. A
// custom name must not collide with a built-in DOMAIN_EVENT_TYPES member (the
// handler enforces the reserved-name guard).
//
// Three things may emit an instance of a custom type: an external system (the
// POST /event-types/:name/emit endpoint), a workflow itself (the SDK emit_event
// action — workflow-to-workflow chaining), or a Pegasus domain condition
// (`domainCondition` below) evaluated by the dispatcher.
// ---------------------------------------------------------------------------

model TenantEventType {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Tenant-defined event name. Unique per tenant; must NOT collide with a
  /// built-in DOMAIN_EVENT_TYPES member. Slug: [a-z][a-z0-9_.-]{0,127}.
  name String

  description String?

  /// Optional JSON Schema (draft-07). When set, the emit endpoint validates the
  /// instance payload against it and rejects a mismatch.
  payloadSchema Json? @map("payload_schema")

  /// Optional derivation rule `{ sourceEventType, filter }`. When a built-in
  /// domain event of `sourceEventType` matches `filter`, the dispatcher emits an
  /// instance of THIS custom type. `sourceEventType` is validated at create time
  /// to be a built-in name only, so custom events can never be a derivation
  /// source — derivation cycles are structurally impossible.
  domainCondition Json? @map("domain_condition")

  /// Cheap pre-filter for the dispatcher's per-event derivation sweep: true iff
  /// domainCondition is set. Lets the common (no-condition) tick short-circuit.
  hasDomainCondition Boolean @default(false) @map("has_domain_condition")

  enabled         Boolean @default(true)
  createdByUserId String  @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  // Supports the dispatcher's cross-tenant derivation sweep (Unit 8): only rows
  // that actually carry a condition are scanned.
  @@index([hasDomainCondition, enabled])
  @@map("tenant_event_types")
  @@schema("public")
}

enum WorkflowSecretConfigKind {
  SECRET
  CONFIG

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflow secrets & configuration — per-tenant key/value store that a running
// workflow reads at runtime via the SDK (PegasusClient.get_secret/get_config).
//
// Two kinds share one table via the `kind` discriminator:
//   - SECRET: write-once, value KMS-encrypted into `valueCiphertext` (the
//     plaintext is NEVER returned by the management API nor stored in `value`).
//   - CONFIG: plain key/value, editable, stored in `value` (no ciphertext).
//
// Scope is per-tenant (shared): every workflow the tenant owns reads the same
// namespace. Management routes require Cognito + ManageWorkflowSecrets/Configs;
// the runtime read routes require the vnd_ runtime key's ReadWorkflowSecret/
// ReadWorkflowConfig Cedar action (declared in the workflow manifest).
//
// Tenant-owned only (no GLOBAL case), so the model lives in TENANT_SCOPED_MODELS
// — reads auto-scope to the current tenant via the Prisma extension.
// ---------------------------------------------------------------------------
model WorkflowSecretConfig {
  id       String                   @id @default(uuid())
  tenantId String                   @map("tenant_id")
  kind     WorkflowSecretConfigKind

  /// Logical group for organizing entries within a tenant (e.g. "billing",
  /// "notifications"). Entries created without one land in "global". Part of the
  /// uniqueness key, so the same key may exist in different groups.
  group String @default("global") @map("group_name")

  /// Lookup key, env-var style: [a-zA-Z_][a-zA-Z0-9_]{0,127}. Unique per
  /// (tenant, kind, group) — a SECRET and a CONFIG may share a key, and the same
  /// key may recur across groups (separate namespaces).
  key String

  /// Plain value for CONFIG rows. Always NULL for SECRET rows.
  value String?

  /// KMS-encrypted (base64) value for SECRET rows. Always NULL for CONFIG rows.
  /// MUST NOT be returned in any API response.
  valueCiphertext String? @map("value_ciphertext")

  /// Stamped by the server at creation: true for SECRET, false for CONFIG.
  /// Drives response shaping so the mapper never emits a secret value.
  isSecret Boolean @default(false) @map("is_secret")

  description String?

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind, group, key])
  @@index([tenantId, kind])
  @@map("workflow_secret_configs")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Integration projections — a per-record cache of an external system's
// last-known state, keyed by (tenant, integrationId, entityType, entityKey).
//
// A running workflow mirrors the external system into this table via the SDK
// (PegasusClient.put_projection); the integration validator reads the matching
// row's `state` as the `prior` input so transition rules can pre-validate an
// update without the caller resupplying prior state.
//
//   - integrationId is a code-defined slug (e.g. "demo_partner"), NOT an FK — the
//     integration registry lives in code, same precedent as IntegrationConfig.
//   - `state` is the integration's NATIVE payload shape (identical to the
//     validate `order`/`prior` body), so it transforms through the same mapping.
//   - Durable, last-write-wins; `version` is a monotonic write counter.
//
// Tenant-owned only (no GLOBAL case), so the model lives in TENANT_SCOPED_MODELS
// — reads/writes auto-scope to the current tenant via the Prisma extension.
// ---------------------------------------------------------------------------
model IntegrationProjection {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  integrationId String @map("integration_id")
  entityType    String @map("entity_type")
  entityKey     String @map("entity_key")

  /// Last-known external state, in the integration's NATIVE payload shape.
  state Json

  /// Monotonic counter bumped on each write — observability + future If-Match.
  version Int @default(1)

  /// workflow_runtime service-account user id that last wrote the row.
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, integrationId, entityType, entityKey])
  @@index([tenantId, integrationId, entityType])
  @@map("integration_projections")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Tenant broker credentials — per-tenant tokens for the workflow broker.
//
// Phase 3 Unit 7 (the sandbox security keystone). A tenant-runner container
// (Unit 8) must never hold the global WORKFLOW_BROKER_SECRET — tenant code
// imported by the runner could read it from the environment and mint ANY
// tenant's runtime token. Instead each tenant gets exactly one opaque token
// `wbk_<tenantId>_<48 hex>`; the broker endpoints accept it but enforce
// `execution.tenantId === credential.tenantId` on every request, so a leaked
// token only ever exposes the holding tenant's own executions.
//
// Two at-rest forms, deliberately:
//   * tokenHash       — SHA-256 of the full token. The broker verifies against
//                       this (timing-safe) and never needs the plaintext back.
//   * tokenCiphertext — KMS-encrypted plaintext (same key as
//                       Workflow.runtimeTokenCiphertext). Exists ONLY so the
//                       Unit 9 dispatcher can recover the plaintext at ECS
//                       task-launch time and inject it into the runner's env.
//
// Minted lazily by lib/tenant-broker-credential.ts (no HTTP surface). NOT in
// TENANT_SCOPED_MODELS — only the broker auth path and the dispatcher touch
// it, both via the root `db` (same precedent as ApiClient).
// ---------------------------------------------------------------------------

model TenantBrokerCredential {
  id       String @id @default(uuid())
  /// Owning tenant. Unique — at most one active credential per tenant, which
  /// is also what makes rotation revoke the previous token (the row's hash is
  /// replaced, so the old plaintext stops verifying).
  tenantId String @unique @map("tenant_id")

  /// SHA-256 hex digest of the full token — compared with timing-safe
  /// equality at the broker. Never returned in API responses.
  tokenHash String @map("token_hash")

  /// KMS-encrypted token plaintext (base64 ciphertext), for the runner
  /// dispatcher to decrypt at task launch. Never returned in API responses.
  tokenCiphertext String @map("token_ciphertext")

  /// Stamped whenever the credential is rotated. Null = never rotated.
  rotatedAt DateTime? @map("rotated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_broker_credentials")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// WireGuard VPN peers — one row per tenant that has VPN connectivity enabled.
//
// Per-tenant peer state for the multi-tenant WireGuard hub. Only the peer's
// public key is persisted; the tenant private key is returned once in the
// client.conf response and never stored server-side. Allocation of the overlay
// IP (10.200.<octet1>.<octet2>) is tracked via (assignedOctet1, assignedOctet2)
// with a composite unique constraint to prevent collisions.
//
// VpnState is a singleton row holding a monotonic `generation` counter bumped
// on every peer mutation — the hub reconcile agent uses it as an ETag so it
// can short-circuit polling when nothing has changed.
//
// See plans/in-progress/wireguard-multi-tenant-vpn.md Appendix A.
// ---------------------------------------------------------------------------

enum VpnStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

model VpnPeer {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedOctet1  Int
  assignedOctet2  Int
  publicKey       String
  status          VpnStatus @default(PENDING)
  lastHandshakeAt DateTime?
  rxBytes         BigInt    @default(0)
  txBytes         BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([assignedOctet1, assignedOctet2])
  @@index([status])
  @@schema("public")
}

model VpnState {
  id         Int @id @default(1)
  generation Int @default(1)

  @@schema("public")
}

/// Platform-level feature flags for gradual rollout of new capabilities.
/// Not yet surfaced in the admin UI — stub for future use.
model FeatureFlag {
  id          String  @id @default(uuid())
  name        String  @unique
  enabled     Boolean @default(false)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("platform")
}

