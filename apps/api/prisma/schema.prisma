  ANDROID

  @@schema("public")
}

enum RcTokenStatus {
  ACTIVE
  EXPIRED

  @@schema("public")
}

enum RcConnectionHealth {
  HEALTHY
  DEGRADED
  UNHEALTHY

  @@schema("public")
}

enum RcSubscriptionStatus {
