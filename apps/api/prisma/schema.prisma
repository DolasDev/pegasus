// ---------------------------------------------------------------------------
// Pegasus — Prisma Schema
// Translates the domain bounded contexts into PostgreSQL tables.
//
// Two PostgreSQL schemas are used:
//   public   — all tenant-facing tables (@@schema("public") on every model/enum)
//   platform — platform/admin-only tables; never queried by tenant APIs
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
  schemas    = ["public", "platform"]
}

// ---------------------------------------------------------------------------
// Enums — public schema
// ---------------------------------------------------------------------------

enum MoveStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("public")
}

enum StopType {
  PICKUP
  DELIVERY
  STORAGE
  WAYPOINT

  @@schema("public")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("public")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID

  @@schema("public")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  CHECK

  @@schema("public")
}

enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  MISSING

  @@schema("public")
}

enum CrewRole {
  DRIVER
  MOVER
  SUPERVISOR

  @@schema("public")
}

/// SSO identity provider protocol type.
enum SsoProviderType {
  OIDC
  SAML

  @@schema("public")
}

/// Lifecycle status of an invited tenant user.
enum TenantUserStatus {
  /// Invited but has not yet completed first login.
  PENDING
  /// Has completed first login and has an active session.
  ACTIVE
  /// Access revoked — Cognito account disabled, token generation blocked.
  DEACTIVATED

  @@schema("public")
}

/// Lifecycle status of a tenant account, managed by platform administrators.
enum TenantStatus {
  /// Fully operational — tenant users can access the API.
  ACTIVE
  /// Access suspended — tenant middleware returns 403 for this tenant.
  SUSPENDED
  /// Soft-deleted — tenant middleware returns 404; excluded from admin list by default.
  OFFBOARDED

  @@schema("public")
}

/// Subscription plan tier for a tenant account.
enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE

  @@schema("public")
}

/// Lifecycle status of a stored document. The upload state machine is:
/// PENDING_UPLOAD → ACTIVE (via finalize) → ARCHIVED or PENDING_DELETION.
enum DocumentStatus {
  /// Row created and presigned PUT issued; file not yet confirmed in S3.
  PENDING_UPLOAD
  /// Upload finalized and visible to list endpoints.
  ACTIVE
  /// Hidden from default lists, still retrievable.
  ARCHIVED
  /// Soft-deleted; S3 object still present, purged by background worker.
  PENDING_DELETION

  @@schema("public")
}

/// Which pre-generated derived asset this row represents.
enum DocumentVariantKind {
  THUMB
  WEB

  @@schema("public")
}

/// Lifecycle of a single derived-asset row. READY means the converter wrote
/// the variant to S3. FAILED is terminal for decode errors (the download-url
/// endpoint falls back to the original).
enum DocumentVariantStatus {
  PENDING
  READY
  FAILED

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Multi-tenancy — Tenant is the root of every bounded context.
// Each moving-company instance is one Tenant. The slug is the subdomain
// identifier (e.g. "acme" in acme.pegasusapp.com).
// ---------------------------------------------------------------------------

model Tenant {
  id   String @id @default(uuid())
  name String
  slug String @unique

  // -------------------------------------------------------------------------
  // Admin-managed fields (written only by platform admin routes)
  // -------------------------------------------------------------------------

  /// Current lifecycle status. The tenant middleware enforces this:
  /// SUSPENDED → 403, OFFBOARDED → 404, ACTIVE → normal flow.
  status TenantStatus @default(ACTIVE)

  /// Subscription plan tier. Used for feature gating (future).
  plan TenantPlan @default(STARTER)

  /// Primary contact name for this tenant account (billing/support contact).
  contactName String? @map("contact_name")

  /// Primary contact email for this tenant account.
  contactEmail String? @map("contact_email")

  /// When true, Cognito built-in email+password authentication is available as
  /// a login option in addition to (or instead of) configured SSO providers.
  /// When false, only configured SSO providers may be used to log in.
  cognitoAuthEnabled Boolean @default(true) @map("cognito_auth_enabled")

  /// Legacy SQL Server connection string for the pegii bridge API.
  /// Used by mssqlMiddleware to open a connection pool per tenant.
  mssqlConnectionString String? @map("mssql_connection_string")

  /// Per-tenant longhaul client selector — 'nwi' or 'qmm'. Selects the
  /// dispatcher SQL, MoveType filter, and Is_Trip_Planning import/export codes
  /// for the cloud-direct longhaul handlers (handlers/longhaul-cloud/*). The
  /// multi-tenant cloud equivalent of the on-prem server's LONGHAUL_CLIENT env
  /// var. Null until configured. See lib/longhaul-client-config.ts.
  longhaulClient String? @map("longhaul_client")

  /// Set when the tenant is offboarded. Data is retained; the tenant is
  /// excluded from all default queries. Null means not offboarded.
  deletedAt DateTime? @map("deleted_at")

  /// AWS Verified Permissions (Cedar) policy store ID for this tenant.
  /// One AVP store per tenant — Cedar policies and identity-source
  /// configuration are scoped here. Provisioned at tenant-create time
  /// (apps/api/src/lib/authz-provision.ts). Null for legacy tenants
  /// created before this column existed; backfilled out-of-band.
  policyStoreId String? @map("policy_store_id")

  /// True for the single platform-owned tenant whose uploads populate the
  /// GLOBAL workflow library visible to every other tenant. Set manually via
  /// an admin update; no API mutation. See handlers/workflows.ts.
  isPlatformTenant Boolean @default(false) @map("is_platform_tenant")

  /// Tenant-wide UI preferences edited via /settings/app (one nested object per
  /// main-menu section: dashboard, moves, quotes, customers, dispatch, billing,
  /// operations). The shape is defined by AppSettingsSchema in
  /// apps/api/src/lib/app-settings.ts — zod parses-with-defaults on every read
  /// so new optional fields can be added without a migration. The Json column
  /// is an implementation detail; if we move to a flag service later (LD,
  /// AppConfig), the repo seam at lib/app-settings.ts swaps without touching
  /// call sites. Defaults to {} for tenants created before the column existed.
  appSettings Json @default("{}") @map("app_settings")

  // -------------------------------------------------------------------------
  // Relations
  // -------------------------------------------------------------------------

  customers      Customer[]
  moves          Move[]
  quotes         Quote[]
  invoices       Invoice[]
  crewMembers    CrewMember[]
  vehicles       Vehicle[]
  availabilities Availability[]
  inventoryRooms InventoryRoom[]
  leadSources    LeadSource[]
  accounts       Account[]
  rateTables     RateTable[]
  ssoProviders   TenantSsoProvider[]
  users          TenantUser[]
  apiClients     ApiClient[]
  pegasusEvents  PegasusEvent[]
  documents      Document[]
  workflows        Workflow[]
  workflowTriggers WorkflowTrigger[]
  domainEvents     DomainEvent[]
  vpnPeer          VpnPeer?

  // Messaging context — RingCentral SMS capture
  ringCentralConnections   RingCentralConnection[]
  ringCentralSubscriptions RingCentralSubscription[]
  ringCentralSyncCursors   RingCentralSyncCursor[]
  inboundWebhookEvents     InboundWebhookEvent[]
  messages                 Message[]
  messageForwardOutbox     MessageForwardOutbox[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// SSO provider configuration — one record per IdP per tenant.
//
// Each row describes a single identity provider registered in the Cognito User
// Pool for this tenant. Sensitive credentials (client secrets, SAML SP private
// keys) are stored in Secrets Manager; only the ARN reference is persisted here
// and NEVER returned by API responses.
// ---------------------------------------------------------------------------

model TenantSsoProvider {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Display name shown in the login page provider picker (e.g. "Acme Okta").
  name String

  /// Protocol type: OIDC or SAML.
  type SsoProviderType

  /// The Cognito identity provider name — passed as `identity_provider` in the
  /// authorization URL. Must exactly match the name registered in the User Pool.
  cognitoProviderName String @map("cognito_provider_name")

  /// OIDC: discovery document URL (stored for admin reference / future auto-config).
  /// SAML: metadata URL (used when registering the IdP in Cognito).
  metadataUrl String? @map("metadata_url")

  /// OIDC only: the client ID issued by this IdP. Null for SAML providers.
  oidcClientId String? @map("oidc_client_id")

  /// Secrets Manager ARN for the IdP credential.
  /// OIDC: the client secret. SAML: SP private key / assertion signing cert.
  /// Null until a secret is configured. NEVER returned from the API.
  secretArn String? @map("secret_arn")

  /// Whether this provider is offered on the login page.
  isEnabled Boolean @default(true) @map("is_enabled")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, cognitoProviderName])
  @@index([tenantId])
  @@map("tenant_sso_providers")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Tenant user roster — explicit invite list for tenant authentication.
//
// Any user who authenticates via Cognito must have a matching TenantUser record
// with status ACTIVE or PENDING (first login). DEACTIVATED users are blocked
// at token generation by the Pre-Token-Generation Lambda.
//
// Populated by:
//   - POST /api/admin/tenants          (creates ADMIN for the contactEmail)
//   - POST /api/v1/users/invite        (tenant admin invites additional users)
// ---------------------------------------------------------------------------

model TenantUser {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  email    String

  /// Cognito sub claim — null until first successful login.
  cognitoSub String? @map("cognito_sub")

  /// Legacy SQL Server Windows username (v_longhaul_salesman.win_username).
  /// Populated by tenant admins via the user management UI so the cloud →
  /// on-prem proxy can forward an X-Windows-User header that the on-prem
  /// longhaul middleware uses to resolve the legacy user identity.
  legacyWindowsUsername String? @map("legacy_windows_username")

  /// Cedar role-group memberships. Authoritative source for the
  /// `custom:roles` Cognito claim emitted by the pre-token Lambda.
  roleNames     String[]         @default([]) @map("role_names")
  status        TenantUserStatus @default(PENDING)
  invitedAt     DateTime         @default(now()) @map("invited_at")
  activatedAt   DateTime?        @map("activated_at")
  deactivatedAt DateTime?        @map("deactivated_at")

  /// Service-account flag — true for non-human principals owned by API clients.
  /// Service accounts have `cognitoSub = null` and are unable to sign in via
  /// Cognito; they exist solely as the principal an `ApiClient` acts as so
  /// Cedar/AVP authorisation runs through the same code path as human users.
  isServiceAccount Boolean @default(false) @map("is_service_account")

  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  createdApiClients ApiClient[] @relation("ApiClientCreatedBy")
  apiClientsActedAs ApiClient[] @relation("ApiClientActsAs")
  crewMember        CrewMember?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([cognitoSub])
  @@index([legacyWindowsUsername])
  @@map("tenant_users")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Auth session — short-lived record that communicates tenant selection from
// the login UI to the pre-token Lambda. Created by POST /api/auth/select-tenant,
// consumed and deleted by the pre-token Lambda. Expires after 10 minutes.
// ---------------------------------------------------------------------------

model AuthSession {
  id        String   @id @default(uuid())
  email     String
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("auth_sessions")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// API client (M2M) — vendor systems that call the API without a Cognito session
// ---------------------------------------------------------------------------

/// An API key issued to an external vendor for machine-to-machine access.
/// Only a SHA-256 hash of the key is stored — the plaintext is shown once on
/// creation or rotation and never persisted.
model ApiClient {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String

  /// First 12 chars of the full key (e.g. "vnd_a1b2c3d4") — stored plain for
  /// fast prefix-based lookup without a full-table scan.
  keyPrefix String @map("key_prefix")

  /// SHA-256 hex digest of the full key — compared with timing-safe equality.
  keyHash String @unique @map("key_hash")

  /// Granted permission scopes (e.g. ["orders:read", "invoices:write"]).
  scopes String[]

  lastUsedAt DateTime? @map("last_used_at")

  /// Set when the key is revoked. Revoked keys return 403 after hash match.
  revokedAt DateTime? @map("revoked_at")

  /// TenantUser who created this key.
  createdById String @map("created_by")

  /// Service-account TenantUser this key acts as. Cedar/AVP authorisation
  /// runs against this user's roleNames — there is no separate scope set.
  /// Nullable at the column level so the migration is non-destructive; the
  /// API enforces non-null on create/update and validates that the target is
  /// a service account in the same tenant.
  actsAsUserId String? @map("acts_as_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  createdBy  TenantUser  @relation("ApiClientCreatedBy", fields: [createdById], references: [id])
  actsAsUser TenantUser? @relation("ApiClientActsAs", fields: [actsAsUserId], references: [id], onDelete: Restrict)

  @@index([keyPrefix])
  @@index([tenantId])
  @@index([actsAsUserId])
  @@map("api_clients")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Customer context
// ---------------------------------------------------------------------------

model LeadSource {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customers Customer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lead_sources")
  @@schema("public")
}

model Account {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customers Customer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("accounts")
  @@schema("public")
}

model Customer {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  userId       String  @map("user_id")
  accountId    String? @map("account_id")
  leadSourceId String? @map("lead_source_id")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  email        String
  phone        String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  account    Account?    @relation(fields: [accountId], references: [id])
  leadSource LeadSource? @relation(fields: [leadSourceId], references: [id])
  contacts   Contact[]
  moves      Move[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
  @@map("customers")
  @@schema("public")
}

model Contact {
  id         String  @id @default(uuid())
  customerId String  @map("customer_id")
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  email      String
  phone      String?
  isPrimary  Boolean @default(false) @map("is_primary")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("contacts")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Shared — Address value object persisted as its own table
// ---------------------------------------------------------------------------

model Address {
  id         String  @id @default(uuid())
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String  @map("postal_code")
  country    String

  originMoves      Move[] @relation("MoveOrigin")
  destinationMoves Move[] @relation("MoveDestination")
  stops            Stop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("addresses")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Dispatch context
// ---------------------------------------------------------------------------

model Move {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  userId        String     @map("user_id")
  customerId    String?    @map("customer_id")
  status        MoveStatus @default(PENDING)
  originId      String     @map("origin_id")
  destinationId String     @map("destination_id")
  scheduledDate DateTime   @map("scheduled_date")

  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  customer           Customer?               @relation(fields: [customerId], references: [id])
  origin             Address                 @relation("MoveOrigin", fields: [originId], references: [id])
  destination        Address                 @relation("MoveDestination", fields: [destinationId], references: [id])
  stops              Stop[]
  crewAssignments    MoveCrewAssignment[]
  vehicleAssignments MoveVehicleAssignment[]
  quotes             Quote[]
  invoices           Invoice[]
  inventoryRooms     InventoryRoom[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledDate])
  @@map("moves")
  @@schema("public")
}

model Stop {
  id          String    @id @default(uuid())
  moveId      String    @map("move_id")
  type        StopType
  addressId   String    @map("address_id")
  sequence    Int
  scheduledAt DateTime? @map("scheduled_at")
  arrivedAt   DateTime? @map("arrived_at")
  departedAt  DateTime? @map("departed_at")
  notes       String?

  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([moveId])
  @@map("stops")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Schedule context
// ---------------------------------------------------------------------------

model CrewMember {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  role           CrewRole
  licenceClasses String[] @map("licence_classes")
  isActive       Boolean  @default(true) @map("is_active")

  /// Optional link to the tenant login that belongs to this crew member.
  /// Set when a crew member is given a `driver` persona login so the Moves
  /// list/detail can be scoped to their own trips. Nullable, no backfill.
  tenantUserId String? @unique @map("tenant_user_id")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  tenantUser      TenantUser?          @relation(fields: [tenantUserId], references: [id], onDelete: SetNull)
  moveAssignments MoveCrewAssignment[]
  availabilities  Availability[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("crew_members")
  @@schema("public")
}

model Vehicle {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  registrationPlate  String   @map("registration_plate")
  make               String
  model              String
  capacityCubicFeet  Float    @map("capacity_cubic_feet")
  lastInspectionDate DateTime @map("last_inspection_date")
  isActive           Boolean  @default(true) @map("is_active")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  moveAssignments MoveVehicleAssignment[]
  availabilities  Availability[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, registrationPlate])
  @@index([tenantId])
  @@map("vehicles")
  @@schema("public")
}

model Availability {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  crewMemberId String?  @map("crew_member_id")
  vehicleId    String?  @map("vehicle_id")
  windowStart  DateTime @map("window_start")
  windowEnd    DateTime @map("window_end")
  isAvailable  Boolean  @default(true) @map("is_available")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  crewMember CrewMember? @relation(fields: [crewMemberId], references: [id])
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([crewMemberId])
  @@index([vehicleId])
  @@index([windowStart, windowEnd])
  @@map("availabilities")
  @@schema("public")
}

model MoveCrewAssignment {
  moveId       String   @map("move_id")
  crewMemberId String   @map("crew_member_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  move       Move       @relation(fields: [moveId], references: [id], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id])

  @@id([moveId, crewMemberId])
  @@map("move_crew_assignments")
  @@schema("public")
}

model MoveVehicleAssignment {
  moveId     String   @map("move_id")
  vehicleId  String   @map("vehicle_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([moveId, vehicleId])
  @@map("move_vehicle_assignments")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Quoting context
// ---------------------------------------------------------------------------

model RateTable {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(false) @map("is_active")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  rates  Rate[]
  quotes Quote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("rate_tables")
  @@schema("public")
}

model Rate {
  id          String  @id @default(uuid())
  rateTableId String  @map("rate_table_id")
  serviceCode String  @map("service_code")
  description String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  currency    String  @default("USD")

  rateTable RateTable @relation(fields: [rateTableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rateTableId, serviceCode])
  @@index([rateTableId])
  @@map("rates")
  @@schema("public")
}

model Quote {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  moveId        String      @map("move_id")
  rateTableId   String?     @map("rate_table_id")
  status        QuoteStatus @default(DRAFT)
  priceAmount   Decimal     @map("price_amount") @db.Decimal(12, 2)
  priceCurrency String      @default("USD") @map("price_currency")
  validUntil    DateTime    @map("valid_until")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  move      Move            @relation(fields: [moveId], references: [id])
  rateTable RateTable?      @relation(fields: [rateTableId], references: [id])
  lineItems QuoteLineItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([moveId])
  @@index([status])
  @@map("quotes")
  @@schema("public")
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  quoteId     String  @map("quote_id")
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  currency    String  @default("USD")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quoteId])
  @@map("quote_line_items")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Inventory context
// ---------------------------------------------------------------------------

model InventoryRoom {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  moveId   String @map("move_id")
  name     String

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  move   Move            @relation(fields: [moveId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([moveId])
  @@map("inventory_rooms")
  @@schema("public")
}

model InventoryItem {
  id                    String         @id @default(uuid())
  roomId                String         @map("room_id")
  name                  String
  description           String?
  quantity              Int            @default(1)
  declaredValue         Decimal?       @map("declared_value") @db.Decimal(12, 2)
  declaredValueCurrency String?        @default("USD") @map("declared_value_currency")
  conditionAtPack       ItemCondition? @map("condition_at_pack")
  conditionAtDelivery   ItemCondition? @map("condition_at_delivery")

  room InventoryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roomId])
  @@map("inventory_items")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Billing context
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  moveId        String        @map("move_id")
  quoteId       String?       @unique @map("quote_id")
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalCurrency String        @default("USD") @map("total_currency")
  issuedAt      DateTime?     @map("issued_at")
  dueAt         DateTime?     @map("due_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  move     Move      @relation(fields: [moveId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([moveId])
  @@index([status])
  @@map("invoices")
  @@schema("public")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String        @map("invoice_id")
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD")
  method    PaymentMethod
  paidAt    DateTime      @map("paid_at")
  reference String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@map("payments")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Platform schema — admin-only tables
//
// These models live in the `platform` PostgreSQL schema. They are never
// queried by tenant-facing API routes or the tenant-scoped Prisma extension.
// The platform schema is not accessible to TENANT_USER-scoped requests.
// ---------------------------------------------------------------------------

/// Tracks Cognito users who have been granted platform administrator access.
/// A record is upserted on first successful admin portal sign-in using the
/// Cognito sub claim as the stable identifier.
model AdminUser {
  id          String  @id @default(uuid())
  /// Stable Cognito user identifier (JWT `sub` claim). Never changes even if
  /// the user updates their email address.
  cognitoSub  String  @unique @map("cognito_sub")
  email       String  @unique
  displayName String? @map("display_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
  @@schema("platform")
}

/// Append-only audit trail for every action taken by a platform administrator.
///
/// `before` and `after` capture JSON snapshots of the affected resource so the
/// full change history can be reconstructed. Neither field is set for the
/// irrelevant side (before=null on create, after=null on hard delete).
model AuditLog {
  id           String   @id @default(uuid())
  /// Cognito sub of the administrator who performed the action.
  adminSub     String   @map("admin_sub")
  /// Denormalised email for display — avoids joins when rendering the log.
  adminEmail   String   @map("admin_email")
  /// Action identifier. Values: CREATE_TENANT | UPDATE_TENANT |
  /// SUSPEND_TENANT | REACTIVATE_TENANT | OFFBOARD_TENANT
  action       String
  /// Type of the affected resource. Currently always "TENANT".
  resourceType String   @map("resource_type")
  /// ID of the affected resource.
  resourceId   String   @map("resource_id")
  /// Snapshot of the resource before the mutation (null for creates).
  before       Json?
  /// Snapshot of the resource after the mutation (null for hard deletes).
  after        Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  /// No updatedAt — audit logs are immutable once written.
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceId])
  @@index([adminSub])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// Integration events — inbound events published to the Pegasus event queue
// by external vendors and services. The Python-based service processes these
// and writes them to the legacy SQL Server. Events are tenant-scoped and
// deleted from the queue once processed.
// ---------------------------------------------------------------------------

/// An inbound integration event received from an external system or vendor.
/// After the consumer reads and processes the event it is deleted (DELETE /events/:id).
model PegasusEvent {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// External event identifier assigned by the publisher. Unique globally.
  eventApiId String @unique @map("event_api_id")

  /// Logical event type used for routing (e.g. "LEAD_CREATED", "MOVE_UPDATED").
  eventType String @map("event_type")

  /// Original timestamp from the publisher.
  eventDatetime DateTime? @map("event_datetime")

  /// Processing state: NEW → IN_PROGRESS → PROCESSED | ERROR.
  eventStatus String @default("NEW") @map("event_status")

  /// Name or identifier of the system that published this event.
  eventPublisher String? @map("event_publisher")

  /// Arbitrary JSON payload from the publisher — schema varies by event type.
  eventData Json? @map("event_data")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([tenantId, eventStatus])
  @@map("pegasus_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Document storage — polymorphic attachments for any tenant entity.
//
// The row is created with status PENDING_UPLOAD when a presigned PUT URL is
// issued. After the client confirms the upload, a finalize call promotes it
// to ACTIVE. S3 coordinates (bucket/key) are infrastructure and never leak
// past the repository layer.
// ---------------------------------------------------------------------------

model Document {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Polymorphic back-reference. Not a FK — entity tables live in many
  /// bounded contexts. Tenant scoping plus the composite index keeps lookups
  /// cheap.
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Free-form classification (e.g. "contract", "photo", "bol", "receipt").
  documentType String  @map("document_type")
  category     String?

  s3Bucket  String @map("s3_bucket")
  s3Key     String @map("s3_key")
  filename  String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  status     DocumentStatus @default(PENDING_UPLOAD)
  /// TenantUser.id of the uploader.
  uploadedBy String         @map("uploaded_by")
  expiresAt  DateTime?      @map("expires_at")
  deletedAt  DateTime?      @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  variants DocumentVariant[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, documentType])
  @@index([tenantId, status])
  @@map("documents")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Document variants — eager derived assets (thumb + web) generated out-of-band
// by the converter Lambda. One row per (document, variant). The unique
// constraint + upsert is the entire concurrency story: re-delivery of the
// S3 ObjectCreated event is a no-op.
// ---------------------------------------------------------------------------

model DocumentVariant {
  id            String                @id @default(uuid())
  documentId    String                @map("document_id")
  variant       DocumentVariantKind
  status        DocumentVariantStatus @default(PENDING)
  s3Key         String?               @map("s3_key")
  sizeBytes     Int?                  @map("size_bytes")
  width         Int?
  height        Int?
  failureReason String?               @map("failure_reason")
  generatedAt   DateTime?             @map("generated_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, variant])
  @@index([status])
  @@map("document_variants")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflows — uploaded Python workflow artifacts.
//
// Each row represents one immutable (name, version) tuple owned by a tenant.
// Visibility=GLOBAL workflows belong to the platform tenant and are readable
// by every tenant; visibility=TENANT workflows are readable only by the
// owning tenant. The artifact itself is a zip stored in the documents bucket
// at `workflows/{tenantId}/{workflowId}/{version}.zip`.
//
// Not included in TENANT_SCOPED_MODELS (see lib/prisma.ts) because the GLOBAL
// case requires reading rows owned by a different tenant. The repository
// scopes manually.
// ---------------------------------------------------------------------------

enum WorkflowVisibility {
  /// Owned by the platform tenant; readable by every tenant.
  GLOBAL
  /// Owned by a single tenant; readable only by that tenant.
  TENANT

  @@schema("public")
}

/// Lifecycle status of a single server-side workflow execution. The runtime
/// state machine is: QUEUED → RUNNING → COMPLETED | FAILED | TIMED_OUT |
/// CANCELLED.
enum WorkflowExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED

  @@schema("public")
}

/// What kind of trigger a WorkflowTrigger row describes. EVENT rows match
/// domain-event outbox rows; SCHEDULE rows are realized as Temporal Schedules
/// (Phase 3 Unit 4 — inert until then).
enum WorkflowTriggerKind {
  EVENT
  SCHEDULE

  @@schema("public")
}

/// Provenance of a WorkflowExecution: started manually by a user (USER) or
/// fired by a trigger (EVENT / SCHEDULE). Trigger-fired executions have no
/// triggeredByUserId.
enum WorkflowExecutionTriggerSource {
  USER
  EVENT
  SCHEDULE

  @@schema("public")
}

model Workflow {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Workflow name (matches the SDK manifest `name` field).
  name String

  /// Workflow version (matches the SDK manifest `version` field). Together
  /// with (tenantId, name) this forms a unique tuple — uploads are immutable.
  version String

  /// Derived server-side from the uploading principal's tenant — GLOBAL if
  /// the tenant has isPlatformTenant=true, TENANT otherwise.
  visibility WorkflowVisibility @default(TENANT)

  /// S3 key inside the documents bucket. Never returned in API responses.
  artifactKey String @map("artifact_key")

  /// Validated manifest payload from the upload, kept for display
  /// (entry-point listing, activity declarations) without re-reading S3.
  manifest Json

  /// TenantUser.id of the uploader (the principal that called finalize).
  /// Denormalised; not an FK so the row survives user deletion.
  createdByUserId String @map("created_by_user_id")

  /// Set when this workflow was created by forking another workflow (the
  /// "fork to my store" flow). Holds the source Workflow.id. Null for
  /// directly-uploaded workflows. Not an FK so the row survives source
  /// deletion.
  forkedFromWorkflowId String? @map("forked_from_workflow_id")

  /// The source workflow's version at the time of the fork. Null for
  /// directly-uploaded workflows.
  forkedFromVersion String? @map("forked_from_version")

  /// Encrypted runtime credential (ciphertext) for the per-workflow runtime
  /// service account. Null until a runtime account is provisioned. Never
  /// returned in API responses.
  runtimeTokenCiphertext String? @map("runtime_token_ciphertext")

  /// ApiClient.id of the per-workflow runtime service account. Null until a
  /// runtime account is provisioned.
  runtimeApiClientId String? @map("runtime_api_client_id")

  /// SHA-256 (hex) of the artifact zip, computed server-side at finalize
  /// (Phase 3 Unit 6). Null for rows finalized before integrity validation
  /// existed — they become executable on re-upload.
  artifactSha256 String? @map("artifact_sha256")

  /// Artifact zip size in bytes, recorded at finalize alongside the digest.
  /// Null for pre-Unit-6 rows.
  artifactSizeBytes Int? @map("artifact_size_bytes")

  /// True when the artifact passed integrity validation at finalize (zip
  /// structure sound, every manifest entry point resolves to a file in the
  /// zip, no pip dependencies, within the 10 MB cap). Derived server-side
  /// only — never client-settable. NOTE: the run path still enforces the
  /// curated-names gate (lib/curated-workflows.ts) until Phase 3 Unit 10;
  /// this flag records *eligibility*, it does not open execution yet.
  executable Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  executions WorkflowExecution[]
  triggers   WorkflowTrigger[]

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@index([visibility])
  @@map("workflows")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflow executions — server-side runtime invocations of a workflow.
//
// Each row records one execution of a Workflow: the input it was given, its
// lifecycle status, the eventual result or error, and the Temporal workflow
// /run identifiers that back the runtime. Always owned by a single tenant —
// included in TENANT_SCOPED_MODELS (see lib/prisma.ts) so reads/writes are
// auto-scoped.
// ---------------------------------------------------------------------------

model WorkflowExecution {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The workflow this execution runs.
  workflowId String @map("workflow_id")

  /// Lifecycle status of this execution.
  status WorkflowExecutionStatus @default(QUEUED)

  /// The input payload the execution was started with.
  input Json

  /// The result payload on successful completion. Null until COMPLETED.
  result Json?

  /// Human-readable failure reason. Set for FAILED / TIMED_OUT / CANCELLED.
  errorMessage String? @map("error_message")

  /// Temporal workflow identifier backing this execution. Null until queued
  /// onto the runtime.
  temporalWorkflowId String? @map("temporal_workflow_id")

  /// Temporal run identifier backing this execution. Null until queued.
  temporalRunId String? @map("temporal_run_id")

  /// TenantUser.id of the principal that triggered this execution. Null for
  /// trigger-fired executions (triggerSource EVENT / SCHEDULE) — those carry
  /// triggeredByTriggerId instead. Denormalised; not an FK so the row
  /// survives user deletion.
  triggeredByUserId String? @map("triggered_by_user_id")

  /// Provenance of this execution. USER = manual POST /:id/run; EVENT /
  /// SCHEDULE = fired by a WorkflowTrigger (Phase 3 Units 3/4).
  triggerSource WorkflowExecutionTriggerSource @default(USER) @map("trigger_source")

  /// WorkflowTrigger.id that fired this execution. Null for USER-source
  /// executions. Denormalised; not an FK so the row survives trigger deletion.
  triggeredByTriggerId String? @map("triggered_by_trigger_id")

  queuedAt   DateTime  @map("queued_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([tenantId, workflowId])
  @@index([status])
  @@map("workflow_executions")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Workflow triggers — event / schedule subscriptions that fire a workflow.
//
// Each row attaches one trigger to one workflow. EVENT rows subscribe to a
// domain-event type (canonical taxonomy in apps/api/src/lib/domain-events.ts)
// with an optional payload-match filter; SCHEDULE rows carry a cron
// expression realized as a Temporal Schedule in Phase 3 Unit 4 — until then
// SCHEDULE rows are stored but inert. Nothing fires triggers yet: the Unit 3
// dispatcher will match enabled EVENT rows against undispatched DomainEvent
// rows via the (kind, enabled, eventType) index below.
//
// Always owned by a single tenant (a tenant's trigger on a GLOBAL workflow is
// still the tenant's own row) — included in TENANT_SCOPED_MODELS (see
// lib/prisma.ts) so reads/writes are auto-scoped.
// ---------------------------------------------------------------------------

model WorkflowTrigger {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The workflow this trigger fires. Cascade so a deleted workflow's
  /// triggers do not linger.
  workflowId String @map("workflow_id")

  /// EVENT (domain-event subscription) or SCHEDULE (cron).
  kind WorkflowTriggerKind

  /// EVENT kind: one of the five domain-event types (lib/domain-events.ts).
  /// Null for SCHEDULE rows.
  eventType String? @map("event_type")

  /// EVENT kind: optional payload-match object. Opaque in this unit — the
  /// Unit 3 dispatcher defines match semantics. Null for SCHEDULE rows.
  filter Json?

  /// SCHEDULE kind: 5-field cron expression. Shape-validated at the API;
  /// full semantic validation happens when Unit 4 realizes it as a Temporal
  /// Schedule. Null for EVENT rows.
  cronExpression String? @map("cron_expression")

  /// Disabled triggers are kept but never fired.
  enabled Boolean @default(true)

  /// TenantUser.id of the creator. Denormalised; not an FK so the row
  /// survives user deletion (matches Workflow.createdByUserId).
  createdByUserId String @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId])
  @@index([kind, enabled, eventType])
  @@map("workflow_triggers")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Domain-event outbox — transactional outbox for platform domain events.
//
// Rows are written by emitDomainEvent() (lib/domain-events.ts) inside the SAME
// Prisma transaction as the domain state change they describe, which keeps
// emission atomic with the write. Nothing consumes the table yet — the Phase 3
// trigger dispatcher (a poller Lambda mirroring the reconcile-poller pattern)
// will drain undispatched rows in (dispatchedAt, occurredAt) order and stamp
// dispatchedAt. The five launch event types are a public contract; see
// lib/domain-events.ts for the canonical taxonomy.
// ---------------------------------------------------------------------------

model DomainEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Event taxonomy name (e.g. "quote.accepted"). Canonical list lives in
  /// apps/api/src/lib/domain-events.ts — renames are breaking.
  eventType String @map("event_type")

  /// Event-specific payload (entity ids + minimal context). Consumers must
  /// refetch authoritative state; the payload is a pointer, not a snapshot.
  payload Json

  /// When the domain state change happened (transaction time).
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Stamped by the trigger dispatcher once the event has been processed.
  /// Null = pending. Drain order is (dispatchedAt, occurredAt).
  dispatchedAt DateTime? @map("dispatched_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([dispatchedAt, occurredAt])
  @@index([tenantId])
  @@map("domain_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// WireGuard VPN peers — one row per tenant that has VPN connectivity enabled.
//
// Per-tenant peer state for the multi-tenant WireGuard hub. Only the peer's
// public key is persisted; the tenant private key is returned once in the
// client.conf response and never stored server-side. Allocation of the overlay
// IP (10.200.<octet1>.<octet2>) is tracked via (assignedOctet1, assignedOctet2)
// with a composite unique constraint to prevent collisions.
//
// VpnState is a singleton row holding a monotonic `generation` counter bumped
// on every peer mutation — the hub reconcile agent uses it as an ETag so it
// can short-circuit polling when nothing has changed.
//
// See plans/in-progress/wireguard-multi-tenant-vpn.md Appendix A.
// ---------------------------------------------------------------------------

enum VpnStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

model VpnPeer {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedOctet1  Int
  assignedOctet2  Int
  publicKey       String
  status          VpnStatus @default(PENDING)
  lastHandshakeAt DateTime?
  rxBytes         BigInt    @default(0)
  txBytes         BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([assignedOctet1, assignedOctet2])
  @@index([status])
  @@schema("public")
}

model VpnState {
  id         Int @id @default(1)
  generation Int @default(1)

  @@schema("public")
}

/// Platform-level feature flags for gradual rollout of new capabilities.
/// Not yet surfaced in the admin UI — stub for future use.
model FeatureFlag {
  id          String  @id @default(uuid())
  name        String  @unique
  enabled     Boolean @default(false)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("platform")
}

// ===========================================================================
// Messaging context — RingCentral SMS capture
//
// Captures SMS from both the RingCentral Thread Messaging store and the legacy
// v1.0 message-store, buffers them in Neon, and forwards them idempotently to
// the on-prem SQL Server (system of record). The cloud `Message` row is a
// transient idempotency buffer — body purged 72h after forward, row deleted at
// 30 days. Mirrors the domain `messaging` bounded context (packages/domain).
//
// All models additive / expand-only. tenantId is the 2nd field on every model
// so the schema-sync regex in prisma-tenant-isolation.test.ts captures it.
// ===========================================================================

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("public")
}

enum MessageSource {
  THREAD_STORE
  V1_STORE

  @@schema("public")
}

enum MessageStatus {
  CAPTURED
  FORWARDED
  FAILED

  @@schema("public")
}

enum ForwardStatus {
  PENDING
  SENT
  FAILED
  DEAD

  @@schema("public")
}

enum RcTokenStatus {
  ACTIVE
  EXPIRED

  @@schema("public")
}

enum RcConnectionHealth {
  HEALTHY
  DEGRADED
  UNHEALTHY

  @@schema("public")
}

enum RcSubscriptionStatus {
  ACTIVE
  EXPIRING
  BLACKLISTED
  DEAD

  @@schema("public")
}

enum RcSyncStore {
  THREAD
  V1

  @@schema("public")
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("public")
}

/// One connected RingCentral account per tenant (covering one or more
/// SMS-enabled numbers). The rotating OAuth refresh token lives in Secrets
/// Manager; only its ARN is persisted here and is NEVER returned by any API.
model RingCentralConnection {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// RingCentral account id (the `~` account this connection authorises).
  rcAccountId String @map("rc_account_id")

  /// RingCentral extension id whose token/number this connection owns.
  rcExtensionId String @map("rc_extension_id")

  /// The primary SMS-enabled number for this connection, E.164.
  ownerNumber String @map("owner_number")

  /// Secrets Manager ARN holding the rotating OAuth refresh token.
  /// Null until the OAuth connect flow completes. NEVER returned from the API.
  tokenSecretArn String? @map("token_secret_arn")

  tokenStatus     RcTokenStatus      @default(ACTIVE) @map("token_status")
  scopes          String[]
  lastRefreshedAt DateTime?          @map("last_refreshed_at") @db.Timestamptz(6)
  health          RcConnectionHealth @default(HEALTHY)

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subscriptions RingCentralSubscription[]
  syncCursors   RingCentralSyncCursor[]
  messages      Message[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, rcAccountId, rcExtensionId])
  @@index([tenantId])
  @@map("ringcentral_connections")
  @@schema("public")
}

/// A managed RingCentral webhook subscription. One shared webhook URL serves
/// all tenants; each subscription carries its own verificationToken and the
/// event payload's subscriptionId maps back to this row → connection → tenant.
model RingCentralSubscription {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  /// RingCentral's subscription id — the key the webhook payload resolves on.
  subscriptionId String @map("subscription_id")

  eventFilters     String[] @map("event_filters")
  transport        String   @default("WebHook")
  deliveryAddress  String   @map("delivery_address")
  /// Shared secret echoed by RC on each delivery; compared on the webhook leg.
  verificationToken String  @map("verification_token")

  expiresAt     DateTime             @map("expires_at")
  status        RcSubscriptionStatus @default(ACTIVE)
  lastRenewedAt DateTime?            @map("last_renewed_at")
  failureCount  Int                  @default(0) @map("failure_count")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([subscriptionId])
  @@index([tenantId])
  @@index([connectionId])
  @@index([status, expiresAt])
  @@map("ringcentral_subscriptions")
  @@schema("public")
}

/// Per-store sync token — the reconciliation-sync safety net's memory.
model RingCentralSyncCursor {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  store      RcSyncStore
  syncToken  String?     @map("sync_token")
  lastSyncAt DateTime?   @map("last_sync_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, connectionId, store])
  @@index([tenantId])
  @@map("ringcentral_sync_cursors")
  @@schema("public")
}

/// Raw webhook event inbox — fast-ack landing zone for replay/audit. Persisted
/// only after the subscriptionId resolves to a tenant (the handshake returns
/// before any row is written).
model InboundWebhookEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  subscriptionId String? @map("subscription_id")
  connectionId   String? @map("connection_id")

  rawPayload Json @map("raw_payload")
  headers    Json

  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  status      WebhookEventStatus @default(PENDING)
  error       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([receivedAt])
  @@map("inbound_webhook_events")
  @@schema("public")
}

/// A normalised captured SMS — transient cloud buffer. The `@@unique([tenantId,
/// source, externalId])` is the idempotency linchpin: webhook-path and
/// sync-path upserts converge on it, giving exactly one row per message.
model Message {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  connectionId String? @map("connection_id")

  source     MessageSource
  externalId String           @map("external_id")
  threadId   String?          @map("thread_id")
  direction  MessageDirection
  fromNumber String           @map("from_number")
  toNumber   String           @map("to_number")
  body       String?

  rcCreationTime     DateTime  @map("rc_creation_time") @db.Timestamptz(6)
  rcLastModifiedTime DateTime? @map("rc_last_modified_time") @db.Timestamptz(6)

  status        MessageStatus @default(CAPTURED)
  forwardStatus ForwardStatus @default(PENDING) @map("forward_status")

  /// Set when the PII body is nulled (72h after the forward succeeds).
  bodyPurgedAt DateTime? @map("body_purged_at") @db.Timestamptz(6)
  /// When the body becomes eligible for purge (forward time + 72h).
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(6)

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection RingCentralConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outbox     MessageForwardOutbox?

  @@unique([tenantId, source, externalId])
  @@index([tenantId, forwardStatus])
  @@index([tenantId, rcCreationTime])
  @@map("messages")
  @@schema("public")
}

/// Transactional outbox driving reliable on-prem delivery. One row per Message;
/// the forwarder drains PENDING rows (nextAttemptAt <= now) into the on-prem
/// SQL Server, backing off on failure and dead-lettering after N attempts.
model MessageForwardOutbox {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  messageId String @map("message_id")

  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  status        ForwardStatus @default(PENDING)
  lastError     String?       @map("last_error")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([messageId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("message_forward_outbox")
  @@schema("public")
}
