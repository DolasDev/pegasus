{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": { "signature": true },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": [],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    }
  }
}
