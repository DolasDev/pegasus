{
  // Fail CI on high or critical advisories. Moderates/lows are still reported but non-blocking,
  // matching the prior `npm audit --audit-level=high` policy.
  "high": true,

  // Advisories listed here are explicitly accepted. Each entry MUST have a tracking note
  // explaining why it's safe and when it can be removed.
  "allowlist": [
    // GHSA-qjx8-664m-686j — js-cookie@2.2.1, pulled in only via
    // apps/mobile -> amazon-cognito-identity-js@6.3.16 -> js-cookie (^2.2.1).
    // Not reachable: the advisory is a browser cookie-parsing/XSS issue, and
    // apps/mobile is React Native — amazon-cognito-identity-js uses AsyncStorage
    // there, not document.cookie, so the vulnerable js-cookie path is dead code.
    // No safe transitive bump exists yet (cognito SDK still pins js-cookie ^2.x).
    // REMOVE once amazon-cognito-identity-js ships a release using js-cookie >=3,
    // or replace with an npm `overrides` pin (regenerate the lockfile on the
    // pinned npm@10.8.2 toolchain).
    "GHSA-qjx8-664m-686j"
  ]
}
